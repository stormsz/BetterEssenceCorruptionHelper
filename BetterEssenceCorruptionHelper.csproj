<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>bin\debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DepsDir Condition=" '$(CI_LIBS_PATH)' != '' ">$(CI_LIBS_PATH)</DepsDir>
    <DepsDir Condition=" '$(CI_LIBS_PATH)' == '' ">..\..\..</DepsDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ExileCore">
      <HintPath>$(DepsDir)\ExileCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets">
      <HintPath>$(DepsDir)\GameOffsets.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The test project lives in this folder but is not part of the plugin (the HUD compiles this csproj). -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <InternalsVisibleTo Include="BetterEssenceCorruptionHelper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Essence icons (poewiki inventory art, 32x32), extracted to the config folder at runtime. -->
    <EmbeddedResource Include="Assets\Icons\*.png" LogicalName="BetterEssenceCorruptionHelper.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.90.0.1" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>